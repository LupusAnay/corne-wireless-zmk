#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE       0
#define WIN        1
#define LOWER      2
#define RAISE      3
#define RU_RAISE   4
#define RU_OVERLAY 5
#define GAME_CS    6
#define GAME_FPS   7
#define GAME_FN    8

/ {
    combos {
        compatible = "zmk,combos";

        game_exit {
            timeout-ms = <150>;
            key-positions = <36 37>;
            layers = <GAME_CS GAME_FPS GAME_FN>;
            bindings = <&to BASE>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            require-prior-idle-ms = <155>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <30 31 32 33 34 35 6 7 8 9 10 11 18 19 20 21 22 23 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            require-prior-idle-ms = <155>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        /* Language-switch key:
         * Tap  – executes the macro above (host layout change + overlay toggle);
         * Hold – only toggles the overlay layer (to resync if needed). */

        lang_sw: lang_sw {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&tog>, <&lang_switch>;
        };

        toggle_on: toggle_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
        };
    };

    macros {
        lang_switch: lang_switch_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_SHIFT) &tog RU_OVERLAY>;
        };

        sw_profile: sw_profile {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &macro_param_2to1 &to MACRO_PLACEHOLDER>,
                <&macro_press>;
        };

        // OV_TOG macro no longer required; hold action handles overlay toggle.
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | LBKT |
            // |  ESC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | RBKT |
            //                     | GUI | LWR | SPC |   | BSPC | RSE | ENT |

            display-name = "Base";
            bindings = <
&kp TAB       &kp Q                &kp W            &kp E              &kp R                &kp T        &kp Y          &kp U                 &kp I               &kp O             &kp P                    &kp LBKT
&kp ESCAPE    &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LEFT_COMMAND F  &kp G        &kp H          &hmr RIGHT_COMMAND J  &hmr RIGHT_SHIFT K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMI  &kp SQT
&lang_sw RU_OVERLAY BASE  &kp Z                &kp X            &kp C              &kp V                &kp B        &kp N          &kp M                 &kp COMMA           &kp DOT           &kp FSLH                 &kp RBKT
                                                    &kp LSHFT          &mo RAISE                &kp SPACE    &kp BACKSPACE  &lt LOWER RC(SPACE)       &kp ENTER
            >;
        };

        default_win {
            bindings = <
&trans  &trans           &trans  &trans  &trans        &trans    &trans  &trans        &trans  &trans  &trans                    &trans
&trans  &hml LEFT_WIN A  &trans  &trans  &hml LCTRL F  &trans    &trans  &hmr RCTRL J  &trans  &trans  &hmr RIGHT_WIN SEMICOLON  &trans
&trans  &trans           &trans  &trans  &trans        &trans    &trans  &trans        &trans  &trans  &trans                    &trans
                                 &trans  &trans        &trans    &trans  &trans        &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2    |  3   |  4   |  5   |   |  6   |  7   |  8   |  9   |  0   | BSPC  |
            // | TRNS | TRNS | PREV | PLAY | NEXT | PSCR |   | LFT  | DWN  |  UP  | RGT  | TRNS | TRNS  |
            // | SHFT | BT1  | BT2  | BT3  | BT4  | BT5  |   | BASE | WIN  | FPS  | CS   | TRNS | BTCLR |
            //                      | TRNS | TRNS | TRNS |   | TRNS | TRNS | TRNS |

            display-name = "Lower";
            bindings = <
&kp TAB    &kp N1           &kp N2           &kp N3            &kp N4           &kp N5             &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &kp BSPC
&trans     &trans           &kp C_PREVIOUS   &kp C_PLAY_PAUSE  &kp C_NEXT       &kp PRINTSCREEN    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &bt BT_CLR_ALL
&kp LSHFT  &sw_profile 0 BASE  &sw_profile 1 BASE  &sw_profile 2 BASE   &sw_profile 3 BASE  &sw_profile 4 BASE    &to BASE    &tog WIN    &to GAME_FPS  &to GAME_CS  &trans  &bt BT_CLR
                                             &trans            &trans           &trans             &trans    &trans    &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // |  ;   |  :  |  '  |  "  |  `  |  ~  |   |  -  |  =  |  [  |  ]  |  {  |  }   |
            // |  ,   |  .  |  ?  |  /  |  <  |  >  |   |  _  |  +  |  |  |  \\  | TRNS | TRNS |
            //                     | TRNS | TRNS | TRNS |   | TRNS | TRNS | TRNS |

            display-name = "Raise";
            bindings = <
&kp TAB    &kp EXCL   &kp AT        &kp HASH  &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LPAR  &kp RPAR  &kp BSPC
&kp SEMI   &kp COLON  &kp SQT       &kp DQT   &kp GRAVE  &kp TILDE    &kp MINUS  &kp EQUAL  &kp LBKT      &kp RBKT  &kp LBRC  &kp RBRC
&kp COMMA  &kp DOT    &kp QUESTION  &kp FSLH  &kp LT     &kp GT       &kp UNDER  &kp PLUS   &kp PIPE      &kp BSLH  &trans    &trans
                                    &trans    &trans     &trans       &trans     &trans     &trans
            >;
        };

        ru_raise_layer {
            display-name = "RU Raise";
            bindings = <
&kp TAB        &kp EXCL    &trans      &kp HASH           &kp DOLLAR  &kp PERCENT    &trans     &trans     &kp ASTERISK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LS(N4)     &kp LS(N6)  &kp LS(N4)  &kp LS(N2)         &trans      &trans         &kp MINUS  &kp EQUAL  &trans        &trans    &trans    &trans
&kp LS(SLASH)  &kp SLASH   &kp LS(N7)  &kp LS(BACKSLASH)  &trans      &trans         &kp UNDER  &kp PLUS   &trans        &kp BSLH  &trans    &trans
                                       &trans             &trans      &trans         &trans     &trans     &trans
            >;
        };

        ru_overlay_layer {
            display-name = "RU Overlay";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &mo RU_RAISE   &trans    &trans  &trans  &trans
            >;
        };

        game_cs {
            display-name = "Game CS";
            bindings = <
&kp TAB     &kp N1            &kp N2  &kp W   &kp E   &kp R        &trans  &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT    &kp A   &kp S   &kp D   &kp N3       &trans  &trans  &trans  &trans  &trans  &trans
&kp B       &kp LEFT_CONTROL  &none   &none   &kp F   &kp G        &trans  &trans  &trans  &trans  &trans  &trans
                                      &kp N5  &kp N4  &kp SPACE    &trans  &trans  &trans
            >;
        };

        game_fps {
            display-name = "Game FPS";
            bindings = <
&kp ESC     &kp Q  &kp W  &kp E     &kp R  &kp T        &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHIFT  &kp A  &kp S  &kp D     &kp F  &kp G        &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL   &kp Z  &kp X  &kp C     &kp V  &kp B        &trans  &trans  &trans  &trans  &trans  &trans
                          &kp LALT  &mo GAME_FN  &kp SPACE    &trans  &trans  &trans
            >;
        };

        game_fn {
            display-name = "Game Fn";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5    &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };
    };
};
